# ============================================================
# AssetManager — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# Or run: ./generate_secrets.sh   (auto-fills SECRET_KEY and DB_PASSWORD)
# ============================================================

# REQUIRED: A strong random secret key for session signing and credential encryption.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# REQUIRED: PostgreSQL password. Must match DB_PASSWORD in db service.
DB_PASSWORD=

# Timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# Maximum file upload size in megabytes (default: 16)
MAX_UPLOAD_MB=16

# Database connection pool settings (increase for high traffic)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
